# Copy to .env and paste values. Never commit .env.
#   cp .env.example .env

# --- Telegram (BotFather + https://my.telegram.org ) ---
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Group chat id (negative, e.g. -1001234567890). Bot logs ignored chats.
ALLOWED_CHAT_ID=
# Forum General topic. Telegram uses 1 for General in most groups.
ALERT_THREAD_ID=1

# Local Bot API inside docker-compose. Override only if you change the service name.
TELEGRAM_API_BASE=http://telegram-bot-api:8081

# debug | info | error. Noisy libs (musicbrainzngs, httpx, …) stay quiet unless debug.
LOG_LEVEL=info
# Seconds the chosen cover stays visible before the picker gallery is deleted.
COVER_CHOICE_HOLD_SECONDS=2
# If true, upload a source report .log next to the FLAC on Drive (never stored on the VM).
ENABLE_LOG_PER_MUSIC_FILE=false
# Flag-only FLAC authenticity (flac-detective). Never blocks upload or review routing.
AUTHENTICITY_CHECK=true
# Seconds of audio to analyse. -1 = entire file.
AUTHENTICITY_SAMPLE_SECONDS=15
# Include upsample/padded-24 flags in the stamped line.
AUTHENTICITY_FLAG_HIRES=true

# --- AcoustID (https://acoustid.org/new-application) ---
ACOUSTID_API_KEY=
# Fingerprint score below this goes to review instead of straight to the library.
ACOUSTID_MIN_SCORE=0.8

# --- MusicBrainz (no key; must be a real contact UA) ---
MUSICBRAINZ_USER_AGENT=telegram-music-bot/1.0 (you@example.com)

# --- Last.fm (https://www.last.fm/api/account/create) ---
# Optional for tagging; required for /suggest.
LASTFM_API_KEY=

# --- Google Drive (personal My Drive via OAuth, drive.file scope) ---
# Consent screen: enable drive.file + userinfo.email only (no full drive).
# python -m app.drive_auth   → prints token AND new folder IDs
# Existing Music folders cannot be used; this app must create the folders.
# Service accounts are not supported: they have 0 My Drive quota.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GDRIVE_REVIEW_FOLDER_ID=

# --- Paths / cleanup ---
# library, review and covers are the only ones exposed over FTPS.
LIBRARY_ROOT=/data/library
REVIEW_ROOT=/data/review
COVERS_ROOT=/data/covers
# Files awaiting a review decision, and scratch space during tagging.
PENDING_ROOT=/data/pending
TMP_ROOT=/data/tmp
STATE_DB=/data/state.sqlite
CLEANUP_CRON=0 3 * * 0
# Genre/mood/language mapping. Defaults to genre_map.yaml next to the app.
# GENRE_MAP_PATH=/app/genre_map.yaml

# --- FTPS (read-only library, review, covers) ---
# Explicit FTP over TLS on port 21. Not SFTP.
FTP_USER=library
FTP_PASSWORD=
# Public IP or DNS name clients use. Wrong value → hang after login (PASV).
FTP_PASV_ADDRESS=
# Passive data ports. Must be open on the host firewall as well.
FTP_PASV_MIN_PORT=21100
FTP_PASV_MAX_PORT=21110
