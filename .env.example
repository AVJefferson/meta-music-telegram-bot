# Copy to .env and paste values. Never commit .env.
#   cp .env.example .env

# --- Telegram (BotFather + https://my.telegram.org ) ---
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Group chat id (negative, e.g. -1001234567890). Bot logs ignored chats.
ALLOWED_CHAT_ID=
# Forum General topic. Telegram uses 1 for General in most groups.
ALERT_THREAD_ID=1

# Local Bot API inside docker-compose. Override only if you change the service name.
TELEGRAM_API_BASE=http://telegram-bot-api:8081

# debug | info | error. Noisy libs (musicbrainzngs, httpx, …) stay quiet unless debug.
LOG_LEVEL=info
# If true, upload a source report .log next to the FLAC on Drive (never stored on the VM).
ENABLE_LOG_PER_MUSIC_FILE=false

# --- AcoustID (https://acoustid.org/new-application) ---
ACOUSTID_API_KEY=

# --- MusicBrainz (no key; must be a real contact UA) ---
MUSICBRAINZ_USER_AGENT=telegram-music-bot/1.0 (you@example.com)

# --- Last.fm optional (https://www.last.fm/api/account/create) ---
LASTFM_API_KEY=

# --- Google Drive (personal My Drive via OAuth, drive.file scope) ---
# Consent screen: enable drive.file + userinfo.email only (no full drive).
# python -m app.drive_auth   → prints token AND new folder IDs
# Existing Music folders cannot be used; this app must create the folders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
GDRIVE_REVIEW_FOLDER_ID=

# --- Paths / cleanup ---
LIBRARY_ROOT=/data/library
REVIEW_ROOT=/data/review
STATE_DB=/data/state.sqlite
COVERS_ROOT=/data/covers
CLEANUP_CRON=0 3 * * 0

# --- FTPS (read-only /data) ---
# Explicit FTP over TLS on port 21. Not SFTP.
FTP_USER=library
FTP_PASSWORD=
# Public IP or DNS name clients use. Wrong value → hang after login (PASV).
FTP_PASV_ADDRESS=
