# Copy to .env and paste values. Never commit .env.
#   cp .env.example .env

# --- Telegram (BotFather + https://my.telegram.org ) ---
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Group chat id (negative, e.g. -1001234567890). Bot logs ignored chats.
ALLOWED_CHAT_ID=
# Forum General topic. Telegram uses 1 for General in most groups.
ALERT_THREAD_ID=1

# Local Bot API inside docker-compose. Override only if you change the service name.
TELEGRAM_API_BASE=http://telegram-bot-api:8081

# --- AcoustID (https://acoustid.org/new-application) ---
ACOUSTID_API_KEY=

# --- MusicBrainz (no key; must be a real contact UA) ---
MUSICBRAINZ_USER_AGENT=telegram-music-bot/1.0 (you@example.com)

# --- Last.fm optional (https://www.last.fm/api/account/create) ---
LASTFM_API_KEY=

# --- Google Drive service account ---
# Compact JSON (jq -c . key.json) as ONE line, wrapped in single quotes.
# Or a path to the JSON file mounted into the container.
# Share both Drive folders with client_email from the JSON (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
GDRIVE_REVIEW_FOLDER_ID=

# --- Paths / cleanup ---
LIBRARY_ROOT=/data/library
REVIEW_ROOT=/data/review
STATE_DB=/data/state.sqlite
CLEANUP_CRON=0 3 * * 0
