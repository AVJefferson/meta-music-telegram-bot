# Copy to .env and paste values. Never commit .env.
#   cp .env.example .env

# --- Telegram (BotFather + https://my.telegram.org ) ---
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Env admin (Telegram user id). Cannot be blacklisted. Required.
ADMIN_TELEGRAM_USER_ID=

# Local Bot API inside docker-compose. Override only if you change the service name.
TELEGRAM_API_BASE=http://telegram-bot-api:8081

# debug | info | error. Noisy libs stay quiet unless debug.
LOG_LEVEL=info
COVER_CHOICE_HOLD_SECONDS=2
ENABLE_LOG_PER_MUSIC_FILE=false
AUTHENTICITY_CHECK=true
AUTHENTICITY_SAMPLE_SECONDS=15
AUTHENTICITY_FLAG_HIRES=true

# --- AcoustID (https://acoustid.org/new-application) ---
ACOUSTID_API_KEY=
ACOUSTID_MIN_SCORE=0.8

# --- MusicBrainz (no key; must be a real contact UA) ---
MUSICBRAINZ_USER_AGENT=telegram-music-bot/1.0 (you@example.com)

# --- Last.fm (https://www.last.fm/api/account/create) ---
# Optional for tagging; required for /suggest.
LASTFM_API_KEY=

# --- Public HTTPS origin (OAuth callback + Mini App). Ignore Host headers. ---
# Must be https:// except http://localhost for dev.
# Mini App buttons require https; http://localhost uses a normal /login link instead.
PUBLIC_BASE_URL=https://music.example.com
OAUTH_HTTP_PORT=8080

# DM access: user must be a member of a known group/channel (default true).
DM_REQUIRES_KNOWN_CHAT=true
USER_INACTIVE_MONTHS=6

# HiFiAudioBot proxy (Telethon user session at /data/hifi.session)
HIFI_BOT_USERNAME=HiFiAudioBot
# docker compose run --rm -it bot python -m app.hifi_login

# Rate limits
RATE_SEARCH_PER_MINUTE=8
RATE_UPLOAD_PER_MINUTE=12
RATE_API_PER_MINUTE=60
OAUTH_TICKET_TTL_SECONDS=600
INITDATA_MAX_AGE_SECONDS=300

# --- Google Drive (per-user web OAuth, PKCE). No global refresh token. ---
# Consent screen: Testing + test users (or Publishing later).
# Client type: Web application. Redirect URI: ${PUBLIC_BASE_URL}/oauth/callback
# Scopes: drive.file, drive.install, userinfo.email, openid
# GOOGLE_CLIENT_SECRET stays on the bot server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Paths / cleanup ---
LIBRARY_ROOT=/data/library
REVIEW_ROOT=/data/review
COVERS_ROOT=/data/covers
CACHE_ROOT=/data/cache
PENDING_ROOT=/data/pending
TMP_ROOT=/data/tmp
STATE_DB=/data/state.sqlite
HIFI_SESSION_PATH=/data/hifi.session
# Daily sweep. Each local/cache file is kept 7 days from its own timestamp, not wiped as a weekly batch.
CLEANUP_CRON=0 3 * * *

# --- FTPS (off by default; compose profile `ftp`) ---
# If enabled, mount only /data/cache. Never sqlite, tokens, or hifi.session.
FTP_USER=library
FTP_PASSWORD=
FTP_PASV_ADDRESS=
FTP_PASV_MIN_PORT=21100
FTP_PASV_MAX_PORT=21110
